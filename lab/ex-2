
import socket

target = input("Enter target IP or hostname: ")

# Scan common ports
ports = [21, 22, 23, 25, 53, 80, 110, 143, 443, 3306, 8080]

print("\nScanning:", target)

try:
    for port in ports:
        s = socket.socket(socket.AF_INET, socket.SOCK_STREAM)
        s.settimeout(0.5)

        result = s.connect_ex((target, port))

        if result == 0:
            print(f"Port {port}: OPEN")
        else:
            print(f"Port {port}: CLOSED or FILTERED")

        s.close()

except socket.gaierror:
    print("Invalid hostname or address.")

except OSError as e:
    print("Scanning error:", e)
